{
  "name": "ai-vs-human-feedback-analysis",
  "build":{
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "mounts": [
  "source=renv-cache,target=/home/rstudio/.local/share/renv/cache,type=volume"
  ],
  "remoteEnv": {
    // renv が使うキャッシュディレクトリを明示
    "RENV_PATHS_CACHE": "/home/rstudio/.local/share/renv/cache"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "r.rterm.linux": "/usr/local/bin/R",
        "r.rpath.linux": "/usr/local/bin/R",
        "r.lsp.path": "/usr/local/bin/R",
        "r.useRenvLibPath": true,
        "r.bracketedPaste": true,
        "r.sessionWatcher": true,
        "files.associations": {
          "*.R": "r",
          ".Rprofile": "r"
        }
      },
      "extensions": [
          "ikuyadeu.r",
          "ms-toolsai.jupyter",
          "ms-python.python",
          "REditorSupport.r",
          "quarto.quarto"
        ]
      }
  },
  "remoteUser": "rstudio",
  "postCreateCommand": "bash ./.devcontainer/postCreateCommand.sh"
}